{
  "name": "frame-one",
  "private": true,
  "scripts": {
    "start": "parcel src/*.twig --open",
    "build": "parcel build src/*.twig --no-source-maps --public-url /",
    "clean": "rm -rf dist",
    "prettier": "prettier --write --ignore-path .gitignore .",
    "stylelint": "stylelint --fix \"**/*.scss\"",
    "stylelint:check": "stylelint \"**/*.scss\"",
    "lint": "eslint --fix .",
    "lint:check": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/slavanga/frame-one.git"
  },
  "author": "Sergio Lavanga",
  "license": "MIT",
  "homepage": "https://www.frameone.ch",
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lodash": "4.18.1",
    "normalize.css": "8.0.1"
  },
  "devDependencies": {
    "@christian-beckmann/parcel-transformer-twig": "0.1.1",
    "@eslint/js": "10.0.1",
    "@parcel/resolver-glob": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "parcel": "2.16.4",
    "parcel-reporter-static-files-copy": "1.5.3",
    "prettier": "3.9.6",
    "prettier-plugin-twig-melody": "0.4.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "svgo": "4.0.2"
  },
  "browserslist": "> 1%, last 2 versions, not dead",
  "@parcel/transformer-css": {
    "drafts": {
      "customMedia": true
    }
  }
}
